rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Products
    match /products/{productId} {
      allow read: if true; // Public access for shoppers
      allow write: if isSignedIn(); // Admin only (simplified for this app's context)
      
      function isValidProduct(data) {
        return data.name is string && data.name.size() <= 200 &&
               data.price is number &&
               data.category is string &&
               data.status in ['Published', 'Draft', 'Out of Stock'];
      }

      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidProduct(incoming());
      allow delete: if isSignedIn();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();

      function isValidCategory(data) {
        return data.name is string && data.name.size() <= 100;
      }

      allow create: if isSignedIn() && isValidCategory(incoming());
      allow update: if isSignedIn() && isValidCategory(incoming());
      allow delete: if isSignedIn();
    }
  }
}
